{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Aff Tech Lab: Build",
      "type": "shell",
      "command": "pnpm build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Aff Tech Lab: Serve",
      "type": "shell",
      "command": "pnpm serve",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "aff-tech-lab",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*node scripts/serve\\.mjs.*$",
          "endsPattern": "^Aff Tech Lab running at http://127\\.0\\.0\\.1:4173$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Aff Tech Lab: Build and Serve",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Aff Tech Lab: Build",
        "Aff Tech Lab: Serve"
      ],
      "problemMatcher": []
    }
  ]
}
